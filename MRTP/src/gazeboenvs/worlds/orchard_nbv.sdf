            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <!-- Rotate so OBJ Y-up becomes world Z-up -->
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <uri>package://gazeboenvs/meshes/trees_orchard/Citrus_orange_35m_no_green.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
